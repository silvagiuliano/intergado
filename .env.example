# Endereços de escuta em desenvolvimento
APP_LISTEN_HOST=0.0.0.0
APP_DEV_PORT=5173
API_LISTEN_HOST=0.0.0.0
PURCHASES_API_PORT=8080
ANALYTICS_API_PORT=8081

# Porta da interface ao usar Docker Compose
WEB_PORT=3000

# Opcional: destinos do proxy Vite, se as APIs estiverem em outra máquina
# PURCHASES_API_URL=http://192.168.1.10:8080
# ANALYTICS_API_URL=http://192.168.1.10:8081

# Login por código enviado por e-mail (Resend)
# E-mails autorizados, separados por vírgula. Quem sair da lista perde o acesso no próximo reinício.
AUTH_ALLOWED_EMAILS=
# Chave da API do Resend. Sem ela, o código aparece apenas no log do Spring Boot.
RESEND_API_KEY=
# Remetente de um domínio verificado no Resend. onboarding@resend.dev só entrega para o dono da conta.
AUTH_EMAIL_FROM=Intergado <onboarding@resend.dev>
# Use true quando o site estiver em HTTPS.
AUTH_COOKIE_SECURE=false
# AUTH_CODE_MINUTES=10
# AUTH_SESSION_DAYS=7
