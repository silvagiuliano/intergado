# Copie para .env e ajuste. O .env é lido pelos scripts dev-*.sh (via `source`),
# pelo Vite e pelo Docker Compose. Use aspas em valores com espaços ou < >.

# --- Rede em desenvolvimento ---
APP_LISTEN_HOST=0.0.0.0
APP_DEV_PORT=5173
API_LISTEN_HOST=0.0.0.0
PURCHASES_API_PORT=8080
ANALYTICS_API_PORT=8081

# Opcional: destinos do proxy Vite, se as APIs estiverem em outra máquina
# PURCHASES_API_URL=http://192.168.1.10:8080
# ANALYTICS_API_URL=http://192.168.1.10:8081

# --- Docker Compose ---
# Porta publicada da interface
WEB_PORT=3000

# --- Login por código enviado por e-mail ---
# E-mails autorizados, separados por vírgula. Vazio: ninguém entra.
# Quem sair da lista perde o acesso no próximo reinício do Spring Boot.
AUTH_ALLOWED_EMAILS=
# Validade do código enviado por e-mail, em minutos
AUTH_CODE_MINUTES=10
# Validade da sessão após o login, em dias
AUTH_SESSION_DAYS=7
# true quando o site for servido por HTTPS (o cookie só trafega em HTTPS)
AUTH_COOKIE_SECURE=false

# --- Resend (https://resend.com/api-keys) ---
# Chave da API, começa com "re_". Vazio: o código aparece apenas no log do Spring Boot.
RESEND_API_KEY=
# Remetente. Precisa ser de um domínio verificado no Resend (https://resend.com/domains).
# O endereço de teste onboarding@resend.dev só entrega para o e-mail dono da conta Resend.
AUTH_EMAIL_FROM="Intergado <onboarding@resend.dev>"
