# Copie para .env e ajuste. O .env é lido pelos scripts dev-*.sh (via `source`),
# pelo Vite e pelo Docker Compose. Use aspas em valores com espaços ou < >.

# --- Rede em desenvolvimento ---
APP_LISTEN_HOST=0.0.0.0
APP_DEV_PORT=5173
API_LISTEN_HOST=0.0.0.0
PURCHASES_API_PORT=8080
ANALYTICS_API_PORT=8081

# Opcional: destinos do proxy Vite, se as APIs estiverem em outra máquina
# PURCHASES_API_URL=http://192.168.1.10:8080
# ANALYTICS_API_URL=http://192.168.1.10:8081

# --- Exposição e HTTPS (Caddy) ---
# Padrão: Caddy geral do host (pacote oficial, caddy.service) atendendo todos os
# projetos. O site do Intergado é gerado deste .env por ./scripts/install-host-caddy.sh
# e encaminha para o Nginx (serviço web) publicado só em 127.0.0.1.
# Para o Caddy próprio do projeto (portas 80/443 deste Compose), descomente:
#   COMPOSE_PROFILES=standalone
#
# Domínio público. Com um domínio real (DNS apontando para este servidor e portas
# 80/443 abertas), o Caddy emite e renova o certificado HTTPS sozinho.
# Nomes locais usam certificado interno (o navegador alerta; curl precisa de -k).
# No Caddy do host use um nome próprio (ex.: intergado.localhost), nunca "localhost".
CADDY_DOMAIN=intergado.localhost
# Nginx publicado só no loopback (127.0.0.1); o Caddy do host usa esta porta.
WEB_PORT=3000
# Só no modo standalone:
# ./caddy/Caddyfile (HTTPS, padrão) | ./caddy/Caddyfile.local (HTTP sem TLS)
CADDYFILE=./caddy/Caddyfile
# Em produção mantenha 80 e 443: a validação do certificado usa a porta 80.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Evolution API (WhatsApp de teste) junto no deploy: descomente.
# COMPOSE_FILE=compose.yaml:compose.evolution.yaml

# --- Login por código enviado por e-mail ---
# Administradores iniciais, separados por vírgula. Na inicialização, cada e-mail que ainda
# não existe é criado como ADMIN; os demais usuários e perfis são cadastrados na tela Usuários.
# Depois de criado, o administrador pode ser alterado ou desativado na tela (por outro
# administrador); o .env não o reativa. Exceção: se não restar nenhum administrador ativo,
# estes e-mails voltam a ser administradores ativos no próximo reinício (recuperação).
# Nome antigo, ainda aceito: AUTH_ALLOWED_EMAILS.
AUTH_ADMIN_EMAILS=
# Validade do código enviado por e-mail, em minutos
AUTH_CODE_MINUTES=10
# Validade da sessão após o login, em dias
AUTH_SESSION_DAYS=7
# true quando o acesso for por HTTPS (Caddy). Com true, o login por http://127.0.0.1:WEB_PORT deixa de funcionar.
AUTH_COOKIE_SECURE=false

# --- Resend (https://resend.com/api-keys) ---
# Chave da API, começa com "re_". Vazio: o código aparece apenas no log do Spring Boot.
RESEND_API_KEY=
# [tela] Remetente. Precisa ser de um domínio verificado no Resend (https://resend.com/domains).
# O endereço de teste onboarding@resend.dev só entrega para o e-mail dono da conta Resend.
AUTH_EMAIL_FROM="Intergado <onboarding@resend.dev>"

# --- WhatsApp · Evolution API (testes) ---
# Os campos marcados com [tela] também podem ser alterados em Integrações, no painel;
# o valor salvo na tela tem prioridade sobre o .env.
# Porta e endereço publicados pelo compose.evolution.yaml (API e painel /manager)
EVOLUTION_LISTEN_HOST=127.0.0.1
EVOLUTION_PORT=8090
# URL usada pelo Spring Boot nos scripts dev-*.sh (no Docker, a URL interna é fixa)
EVOLUTION_API_URL=http://127.0.0.1:8090
# Chave global do Evolution API. Gere uma longa e aleatória: openssl rand -hex 24
EVOLUTION_API_KEY=
# Senha do PostgreSQL interno do Evolution
EVOLUTION_POSTGRES_PASSWORD=evolution
# [tela] Nome da instância (conexão de WhatsApp) no Evolution
EVOLUTION_INSTANCE=intergado
# [tela] WhatsApp que envia: DDI + DDD + número, só dígitos. Ex.: 5591999990000
EVOLUTION_INSTANCE_NUMBER=
# [tela] Destinatários de teste, separados por vírgula. Só eles recebem mensagens.
WHATSAPP_TEST_NUMBERS=
# [tela] Grupos de destino: identificadores terminados em @g.us, separados por vírgula.
# Mais fácil pela tela Integrações (botão "Buscar grupos"). O número que envia precisa participar do grupo.
WHATSAPP_GROUPS=
# [tela] true para avisar os números de teste quando uma compra muda de status
WHATSAPP_ENABLED=false
# [tela] Status que geram aviso. Vazio: todos.
# Opções: RECEIVED,QUOTING,AWAITING_APPROVAL,APPROVED,ORDERED,DELIVERED,PAID
WHATSAPP_NOTIFY_STATUSES=

# --- Telegram · Bot API --- (passo a passo em docs/TELEGRAM.md)
# Token do bot, gerado no @BotFather com /newbot. Segredo: fica só aqui.
TELEGRAM_BOT_TOKEN=
# URL da Bot API. Só mude se usar um servidor local da Bot API.
TELEGRAM_API_URL=https://api.telegram.org
# [tela] chat_id das conversas e grupos de destino, separados por vírgula.
# Mais fácil pela tela Integrações (botão "Buscar conversas"). Grupos começam com -.
TELEGRAM_CHATS=
# [tela] true para avisar as conversas quando uma compra muda de status
TELEGRAM_ENABLED=false
# [tela] Status que geram aviso. Vazio: todos. Mesmas opções do WhatsApp.
TELEGRAM_NOTIFY_STATUSES=
