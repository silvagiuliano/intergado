# Copie para .env e ajuste. O .env é lido pelos scripts dev-*.sh (via `source`),
# pelo Vite e pelo Docker Compose. Use aspas em valores com espaços ou < >.

# --- Rede em desenvolvimento ---
APP_LISTEN_HOST=0.0.0.0
APP_DEV_PORT=5173
API_LISTEN_HOST=0.0.0.0
PURCHASES_API_PORT=8080
ANALYTICS_API_PORT=8081

# Opcional: destinos do proxy Vite, se as APIs estiverem em outra máquina
# PURCHASES_API_URL=http://192.168.1.10:8080
# ANALYTICS_API_URL=http://192.168.1.10:8081

# --- Docker Compose ---
# Porta publicada da interface em HTTP simples (acesso direto ao Nginx, sem Caddy)
WEB_PORT=3000

# --- Caddy (HTTPS na frente do Nginx, só no Docker Compose) ---
# Endereço atendido: localhost, um IP ou um domínio. Vários: "localhost, 192.168.1.10"
# Domínio público com DNS apontado para o servidor e portas 80/443 abertas: certificado Let's Encrypt automático.
CADDY_SITE_ADDRESS=localhost
# auto: Let's Encrypt para domínios públicos e certificado interno para localhost/IP
# internal: sempre certificado interno (rede local ou nome não público; o navegador avisa até confiar na CA do Caddy)
CADDY_TLS=auto
# Portas escutadas e publicadas. Mude se 80/443 já estiverem em uso (Let's Encrypt exige 80/443).
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- Login por código enviado por e-mail ---
# E-mails autorizados, separados por vírgula. Vazio: ninguém entra.
# Quem sair da lista perde o acesso no próximo reinício do Spring Boot.
AUTH_ALLOWED_EMAILS=
# Validade do código enviado por e-mail, em minutos
AUTH_CODE_MINUTES=10
# Validade da sessão após o login, em dias
AUTH_SESSION_DAYS=7
# true quando o acesso for só por HTTPS (Caddy). Com true, o login pela porta HTTP WEB_PORT deixa de funcionar.
AUTH_COOKIE_SECURE=false

# --- Resend (https://resend.com/api-keys) ---
# Chave da API, começa com "re_". Vazio: o código aparece apenas no log do Spring Boot.
RESEND_API_KEY=
# [tela] Remetente. Precisa ser de um domínio verificado no Resend (https://resend.com/domains).
# O endereço de teste onboarding@resend.dev só entrega para o e-mail dono da conta Resend.
AUTH_EMAIL_FROM="Intergado <onboarding@resend.dev>"

# --- WhatsApp · Evolution API (testes) ---
# Os campos marcados com [tela] também podem ser alterados em Integrações, no painel;
# o valor salvo na tela tem prioridade sobre o .env.
# Porta e endereço publicados pelo compose.evolution.yaml (API e painel /manager)
EVOLUTION_LISTEN_HOST=127.0.0.1
EVOLUTION_PORT=8090
# URL usada pelo Spring Boot nos scripts dev-*.sh (no Docker, a URL interna é fixa)
EVOLUTION_API_URL=http://127.0.0.1:8090
# Chave global do Evolution API. Gere uma longa e aleatória: openssl rand -hex 24
EVOLUTION_API_KEY=
# Senha do PostgreSQL interno do Evolution
EVOLUTION_POSTGRES_PASSWORD=evolution
# [tela] Nome da instância (conexão de WhatsApp) no Evolution
EVOLUTION_INSTANCE=intergado
# [tela] WhatsApp que envia: DDI + DDD + número, só dígitos. Ex.: 5591999990000
EVOLUTION_INSTANCE_NUMBER=
# [tela] Destinatários de teste, separados por vírgula. Só eles recebem mensagens.
WHATSAPP_TEST_NUMBERS=
# [tela] true para avisar os números de teste quando uma compra muda de status
WHATSAPP_ENABLED=false
# [tela] Status que geram aviso. Vazio: todos.
# Opções: RECEIVED,QUOTING,AWAITING_APPROVAL,APPROVED,ORDERED,DELIVERED,PAID
WHATSAPP_NOTIFY_STATUSES=
