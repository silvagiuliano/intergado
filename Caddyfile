# Caddy na frente do Nginx (serviço web): HTTPS automático e redirecionamento de HTTP.
# Configuração pelo .env:
#   CADDY_SITE_ADDRESS  localhost, um IP ou um domínio; vários separados por ", " (vírgula e espaço)
#   CADDY_TLS           auto: Let's Encrypt para domínio público, certificado interno para localhost/IP
#                       internal: sempre o certificado interno do Caddy (rede local, nomes não públicos)
#                       off: só HTTP na CADDY_HTTP_PORT, para qualquer host (testes); ignora CADDY_SITE_ADDRESS
#   CADDY_HTTP_PORT / CADDY_HTTPS_PORT  portas escutadas e publicadas (as mesmas, para os redirecionamentos)
{
	http_port {$CADDY_HTTP_PORT:80}
	https_port {$CADDY_HTTPS_PORT:443}
	# The automatic redirect drops the port when it equals https_port, which breaks
	# non-standard ports such as 8443; the http:// block in (redirect) keeps it.
	auto_https disable_redirects
}

(app) {
	encode zstd gzip
	reverse_proxy web:80
}

(redirect) {
	http:// {
		redir https://{host}:{$CADDY_HTTPS_PORT:443}{uri} permanent
	}
}

(site-auto) {
	import redirect
	{$CADDY_SITE_ADDRESS:localhost} {
		import app
	}
}

(site-internal) {
	import redirect
	{$CADDY_SITE_ADDRESS:localhost} {
		tls internal
		import app
	}
}

(site-off) {
	http:// {
		import app
	}
}

import site-{$CADDY_TLS:auto}
